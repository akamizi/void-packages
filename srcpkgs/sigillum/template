# Template file for 'sigillum'
pkgname=sigillum
version=0.2.1
revision=1
build_style=python3-pep517
hostmakedepends="python3-hatchling gettext"
depends="python3
 python3-gobject
 python3-cryptography
 python3-asn1crypto
 python3-lxml
 python3-endesive
 python3-pykcs11
 python3-requests
 python3-attrs
 python3-certifi
 python3-fonttools
 gtk+3
 poppler-glib"
short_desc="GTK app for PAdES/CAdES/XAdES digital signing (eIDAS)"
maintainer="Maurizio Cavalletti <maurizio@akabit.it>"
license="GPL-3.0-or-later"
homepage="https://github.com/piuma/sigillum"
distfiles="https://github.com/piuma/sigillum/archive/refs/tags/v${version}.tar.gz"
checksum=c43fcaa8a6d64d42c31f1ef172198d462dd88cf59657b78c8e5d316f953033a7

post_install() {
	vlicense LICENSE
	vman docs/sigillum.1
	vinstall packaging/flatpak/io.github.sigillum.desktop 644 usr/share/applications
	vinstall packaging/flatpak/io.github.sigillum.svg 644 usr/share/icons/hicolor/scalable/apps
	for po in po/*.po; do
		lang=$(basename "$po" .po)
		vmkdir "usr/share/locale/${lang}/LC_MESSAGES"
		msgfmt -o "${DESTDIR}/usr/share/locale/${lang}/LC_MESSAGES/sigillum.mo" "$po"
	done
}
